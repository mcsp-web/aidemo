# Secrets — never commit. Copy .env.example to .env locally; set real keys in
# Coolify's environment UI, not in the repo.
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local-only: republishes port 8000 for `docker compose up`.
# Coolify reads only docker-compose.yml, so this must stay out of the repo.
docker-compose.override.yml
